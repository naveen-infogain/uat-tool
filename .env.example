# Backend Configuration

# Database URL
# For SQLite (development): sqlite:///./uat_tool.db
# For PostgreSQL: postgresql://user:password@localhost:5432/uat_tool
DATABASE_URL=sqlite:///./uat_tool.db

# Upload settings
UPLOAD_FOLDER=./uploads
MAX_FILE_SIZE=104857600  # 100 MB in bytes

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Email notifications (Brevo) ──────────────────────────────────────────────
# Free: 300 emails/day — sign up at https://www.brevo.com
# Brevo dashboard → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_FROM_EMAIL=noreply@your-domain.com
BREVO_FROM_NAME=UAT Tool

# Recipient addresses
DEVELOPER_EMAIL=satti.naveen@infogain.com
BUSINESS_USER_EMAIL=satti.naveen@infogain.com

# App URL used in email CTA buttons (change to production URL when deploying)
APP_URL=http://localhost:3000

# ── Teams notifications (Incoming Webhook) ───────────────────────────────────
# In Teams: open a channel → ··· menu → Connectors → Incoming Webhook → Configure
# OR (new Teams): channel → ··· → Workflows → "Post to channel when webhook request received"
TEAMS_WEBHOOK_URL=https://yourorg.webhook.office.com/webhookb2/...

# ── Auth ──────────────────────────────────────────────────────────────────
# Secret used to sign JWTs — REQUIRED in production, keep it secret.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh-token cookie flags. Local http dev: leave as-is.
# Cloud Run (https, frontend/backend on different domains): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# First admin account, auto-created on startup if no admin exists yet.
# There's no self-serve password reset — change it via Manage Users after first login.
INITIAL_ADMIN_EMAIL=admin@your-domain.com
INITIAL_ADMIN_PASSWORD=change-me

# Frontend Configuration (in .env or .env.local)

# API URL - Backend endpoint
REACT_APP_API_URL=http://localhost:8000/api

# Demo mode - Show sample data on startup
REACT_APP_DEMO_MODE=false
