UPLOAD_FOLDER=/tmp/uat_uploads
CORS_ORIGINS=http://localhost:3000
MAX_FILE_SIZE=104857600
COMPARISON_TIMEOUT=600

# ── Email notifications (Brevo) ──────────────────────────────────────────────
# Free: 300 emails/day — sign up at https://www.brevo.com
# Brevo dashboard → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_FROM_EMAIL=noreply@your-domain.com
BREVO_FROM_NAME=UAT Tool

# Recipient addresses
DEVELOPER_EMAIL=developer@your-company.com
BUSINESS_USER_EMAIL=business@your-company.com

# ── Teams notifications (Incoming Webhook) ───────────────────────────────────
# In Teams: open a channel → ··· menu → Connectors → Incoming Webhook → Configure
# OR (new Teams): channel → ··· → Workflows → "Post to channel when webhook request received"
TEAMS_WEBHOOK_URL=https://yourorg.webhook.office.com/webhookb2/...

